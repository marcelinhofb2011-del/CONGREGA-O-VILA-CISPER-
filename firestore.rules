rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para o Sistema da Congregação Vila Cisper
    // Leitura livre para toda a congregação consultar programações, territórios e escalas.
    // Gravação permitida para manter sincronismo em tempo real com o painel de administração.
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
